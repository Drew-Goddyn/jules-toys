  "worker_report_contract": {
    "tasks": [
      {
        "task_id": "extract-known-gaps",
        "task_type": "extract_known_gaps",
        "inputs": [
          "deterministic_report",
          "judge_output",
          "review_notes"
        ],
        "output": "cited_gap_list"
      },
      {
        "task_id": "classify-failure-modes",
        "task_type": "classify_failure_modes",
        "inputs": [
          "known_gaps",
          "scorecard_dimensions"
        ],
        "output": "failure_mode_counts"
      },
      {
        "task_id": "compare-scorecard-deltas",
        "task_type": "compare_scorecard_deltas",
        "inputs": [
          "scorecards",
          "rerun_lineage"
        ],
        "output": "dimension_delta_table"
      },
      {
        "task_id": "summarize-evidence",
        "task_type": "summarize_evidence",
        "inputs": [
          "report",
          "screenshot",
          "scorecard",
          "review_notes"
        ],
        "output": "citation_first_summary"
      },
      {
        "task_id": "mark-blocked-honestly",
        "task_type": "mark_blocked_honestly",
        "inputs": [
          "missing_inputs",
          "blocked_reason"
        ],
        "output": "blocked_report"
      }
    ],
    "jules_policy": {
      "required": false,
      "max_cells_per_assignment": 1,
      "allowed_assignment_shapes": [
        "one-cell implementation",
        "one-report extraction"
      ],
      "blocked_path": "Return BLOCKED with missing input names and do not fabricate evidence."
    }
  },
  "rejection_criteria": [
    {
      "id": "missing_artifact",
      "rule": "A completed cell must cite a downloaded evaluator artifact."
    },
    {
      "id": "missing_screenshot",
      "rule": "A completed cell must cite a browser smoke screenshot."
    },
    {
      "id": "missing_deterministic_report",
      "rule": "A completed cell must cite report.json from the evaluator artifact."
    },
    {
      "id": "unparseable_scorecard",
      "rule": "A scorecard must parse and include every required dimension."
    },
    {
      "id": "uncited_claim",
      "rule": "Claims in reports and synthesis must cite report, screenshot, scorecard, observation, issue, PR, workflow, artifact, manifest, or synthesis evidence."
    },
    {
      "id": "duplicate_or_ambiguous_cell_identity",
      "rule": "cell_id and the cell tuple must be unique inside a wave."
    },
    {
      "id": "manual_specimen_data_repair",
      "rule": "Manual specimen JSON edits cannot substitute for evaluator persistence."
    },
    {
      "id": "missing_synthesis",
      "rule": "A wave without synthesis does not count as learning."
    }
  ],
  "synthesis": {
    "path": "docs/pullfrog-fleet/synthesis/wave0-framework.md",
    "procedure": [
      {
        "id": "compare_cells",
        "description": "Compare cells by deterministic checks and every scorecard dimension."
      },
      {
        "id": "identify_repeated_failure_modes",
        "description": "Separate repeated gaps from one-off topic effects."
      },
      {
        "id": "separate_effects",
        "description": "Separate prompt, model, workflow, and specimen-topic effects."
      },
      {
        "id": "record_killed_hypotheses",
        "description": "Record which hypotheses the evidence killed."
      },
      {
        "id": "recommend_next_smallest_wave",
        "description": "Recommend the next smallest useful wave or stop."
      }
    ],
    "wave1_authorization_stub": {
      "cell_count": 5,
      "cells": [
        "W1-BL",
        "W1-ON",
        "W1-MD",
        "W1-VP",
        "W1-RV"
      ],
      "stop_condition": "Stop after one run per authorized cell, reject any uncited or incomplete report, synthesize before launching additional cells."
    }
  },
  "persistence_safety": {
    "guard": "github_actions_job_concurrency",
    "workflow": ".github/workflows/pullfrog-experiment-evaluate.yml",
    "job": "persist-specimen-lab",
    "group": "pullfrog-specimen-lab-persist",
    "cancel_in_progress": false,
    "reason": "All persistence jobs write specimens/pullfrog/specimens.json and one screenshot asset to main, so they must queue instead of racing."
  }
}
